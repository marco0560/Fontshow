{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "editor.detectIndentation": false,
  "editor.renderWhitespace": "boundary",

  "git.useEditorAsCommitInput": true,

  // ----------------------------
  // Ruff (critical for parity)
  // ----------------------------
  "ruff.configuration": "pyproject.toml",
  "ruff.lint.enable": true,
  //"ruff.lint.run": "onType",
  "ruff.format.enable": true,

  // Optional but recommended: avoid double diagnostics
  "python.linting.enabled": false,
  "python.formatting.provider": "none",


  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword.other.git-commit",
        "settings": {
          "foreground": "#C586C0",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Conventional Commit Type",
        "scope": "meta.scope.git-commit",
        "settings": {
          "foreground": "#4EC9B0",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Breaking Change Bang",
        "scope": "punctuation.definition.bold.git-commit",
        "settings": {
          "foreground": "#F44747",
          "fontStyle": "bold"
        }
      }
    ]
  }
}
