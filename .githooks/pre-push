#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PYTHON_BIN="$REPO_ROOT/.venv/bin/python"

if [ ! -x "$PYTHON_BIN" ]; then
  echo "ERROR: repository Python is not available: $PYTHON_BIN" >&2
  echo "Run: uv sync --extra dev" >&2
  exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ] && [ -z "${ALLOW_MAIN_PUSH:-}" ]; then
  echo "ERROR: direct push to main is blocked"
  echo "Use: git rel"
  echo "Emergency workaround: git push --no-verify"
  exit 1
fi

# Allow git rel to bypass double audit
if [ -z "${SKIP_RELEASE_AUDIT:-}" ]; then
  echo "Running release safety audit..."
  scripts/release_audit.sh || exit 1
else
  echo "Skipping release_audit (already executed)"
fi

echo "Running pre-commit checks before push..."
"$PYTHON_BIN" "$REPO_ROOT/scripts/run_repo_tool.py" pre-commit run --all-files
echo "pre-commit checks passed"

echo "Running test suite..."
"$PYTHON_BIN" "$REPO_ROOT/scripts/run_repo_tool.py" pytest -q tests
echo "Tests passed"

# ------------------------------------------------------------
# Optional semantic-release preview (non-blocking)
# ------------------------------------------------------------
echo "Semantic-release preview (optional)..."

if [ -n "${GH_TOKEN:-}" ]; then
  if command -v npx >/dev/null 2>&1; then
    npx semantic-release --dry-run || {
      echo "semantic-release preview failed (non-blocking)"
    }
  else
    echo "npx not available, skipping semantic-release preview"
  fi
else
  echo "GH_TOKEN not set, skipping semantic-release preview"
fi

echo "Pre-push checks completed successfully"
