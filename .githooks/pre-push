#!/bin/sh
set -e

echo "🔐 Running release safety audit..."
scripts/release_audit.sh || exit 1

echo "🔍 Running pre-commit checks before push..."
pre-commit run --all-files
echo "✅ pre-commit checks passed"

echo "🧪 Running test suite..."
pytest -q
echo "✅ Tests passed"

# ------------------------------------------------------------
# Optional semantic-release preview (non-blocking)
# ------------------------------------------------------------
echo "📦 Semantic-release preview (optional)..."

if [ -n "${GH_TOKEN:-}" ]; then
  if command -v npx >/dev/null 2>&1; then
    npx semantic-release --dry-run || {
      echo "⚠ semantic-release preview failed (non-blocking)"
    }
  else
    echo "ℹ npx not available, skipping semantic-release preview"
  fi
else
  echo "ℹ GH_TOKEN not set, skipping semantic-release preview"
fi

echo "🚀 Pre-push checks completed successfully"
